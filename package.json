{
  "name": "market-blaster",
  "version": "0.1.0",
  "description": "Turn a shipped feature into grounded, platform-specific posts for DEV, Hashnode, Gist, Bluesky, Mastodon, LinkedIn, X, HN and Reddit.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Edwin Jose Chittilappilly",
  "repository": {
    "type": "git",
    "url": "https://github.com/edwinjosechittilappilly/market-blaster.git"
  },
  "homepage": "https://edwinjosechittilappilly.github.io/market-blaster/",
  "bugs": "https://github.com/edwinjosechittilappilly/market-blaster/issues",
  "keywords": ["marketing", "cli", "social-media", "publishing"],
  "files": ["bin", "dist", "skills"],
  "publishConfig": { "access": "public", "provenance": true },
  "bin": {
    "mblast": "bin/mblast.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@humanwhocodes/crosspost": "1.0.4",
    "fflate": "0.8.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
